### ZERTIFIKAT-DEPLOYMENT
### ═══════════════════════════════════════════════════════════════════════════

cert_extract() {
  # cert_extract <main-domain> <out-cert> <out-key>
  local domain="$1" out_cert="$2" out_key="$3"

  local cert_b64 key_b64
  cert_b64=$(jq -r --arg r "$ACME_RESOLVER" --arg d "$domain" \
    '.[$r].Certificates[] | select(.domain.main == $d) | .certificate' \
    "$ACME_JSON" 2>/dev/null || true)
  key_b64=$(jq -r --arg r "$ACME_RESOLVER" --arg d "$domain" \
    '.[$r].Certificates[] | select(.domain.main == $d) | .key' \
    "$ACME_JSON" 2>/dev/null || true)

  if [[ -z "$cert_b64" || "$cert_b64" == "null" ]]; then
    warn "Kein Zertifikat für '${domain}' — verfügbare Domains:"
    jq -r --arg r "$ACME_RESOLVER" '.[$r].Certificates[].domain.main' \
      "$ACME_JSON" 2>/dev/null | sed 's/^/    /' || true
    return 1
  fi

  echo "$cert_b64" | base64 -d > "$out_cert"
  echo "$key_b64"  | base64 -d > "$out_key"

  if ! openssl x509 -noout -in "$out_cert" 2>/dev/null; then
    warn "Extrahiertes Zertifikat für ${domain} ist ungültig"; return 1
  fi

  local expiry sans
  expiry=$(openssl x509 -noout -enddate -in "$out_cert" | cut -d= -f2)
  sans=$(openssl x509 -noout -text -in "$out_cert" \
    | grep -A1 "Subject Alternative" | tail -1 \
    | tr ',' '\n' | grep -oP 'DNS:\K[^ ,]+' | tr '\n' ' ' 2>/dev/null || echo "—")
  info "Gültig bis: ${expiry}"
  info "SANs: ${sans}"
}

# publish_mailcow_tlsa <cert-datei>
# Berechnet TLSA 3 1 1 (DANE-EE, SPKI, SHA-256 — RFC 7671 Empfehlung, robust
# gegenüber Zertifikatserneuerung solange derselbe Key wiederverwendet wird)
# aus dem SMTP-Zertifikat und trägt den Record unter _25._tcp.<mail.domain>
# für jede bekannte Mail-Domain ein (alle teilen sich das gleiche SAN-Cert).
# Wirkungslos ohne aktives DNSSEC auf der jeweiligen Zone (RFC 7672: MTAs
# prüfen DANE nur bei DNSSEC-validierten Domains) — daher gefahrlos für
# alle Mail-Domains gleichzeitig pflegbar, auch die ohne DNSSEC.
publish_mailcow_tlsa() {
  local cert_file="$1"

  local tlsa_hash
  tlsa_hash=$(openssl x509 -in "$cert_file" -noout -pubkey 2>/dev/null \
    | openssl pkey -pubin -outform DER 2>/dev/null \
    | openssl dgst -sha256 -hex 2>/dev/null | awk '{print $NF}')
  if [[ -z "$tlsa_hash" ]]; then
    warn "TLSA-Hash konnte nicht berechnet werden — DANE-Update übersprungen"
    return 1
  fi

  local tlsa_content="3 1 1 ${tlsa_hash}"
  local updated=0

  for conf in "${TRAEFIK_CONF_DIR}"/mail-*.yml; do
    [[ -f "$conf" ]] || continue
    # domains[0] in write_traefik_http ist immer "mail.<domain>" (siehe
    # cmd_add_mail_records) — erster Host()-Treffer reicht daher aus
    local mail_host; mail_host=$(grep -oP "Host\(\`\K[^\`]+" "$conf" | head -1)
    [[ -z "$mail_host" ]] && continue

    local domain="${mail_host#mail.}"
    local zone; zone=$(get_zone_for_domain "$domain")
    [[ -z "$zone" ]] && continue
    local sub="${mail_host%.${zone}}"

    set_record "$zone" "_25._tcp.${sub}" "TLSA" "$tlsa_content" 3600
    (( updated++ )) || true
  done

  info "TLSA (_25._tcp, DANE) für ${updated} Mail-Domain(s) aktualisiert"
}

cert_deploy_target() {
  local target_name="$1" force="${2:-0}"
  local cfg="${CERT_TARGETS[$target_name]:-}"
  [[ -z "$cfg" ]] && die "Unbekanntes Target '${target_name}'. Verfügbar: ${!CERT_TARGETS[*]}"

  # Felder aus Konfig-String parsen (:-getrennt)
  # Format: host:cert:key:reload_cmd:main_domain[:owner:group:cert_mode:key_mode]
  local host remote_cert remote_key reload_cmd main_domain
  local remote_owner="" remote_group="" cert_mode="0644" key_mode="0600"
  IFS=':' read -r host remote_cert remote_key reload_cmd main_domain remote_owner remote_group cert_mode_cfg key_mode_cfg <<< "$cfg"
  [[ -n "${cert_mode_cfg:-}" ]] && cert_mode="$cert_mode_cfg"
  [[ -n "${key_mode_cfg:-}"  ]] && key_mode="$key_mode_cfg"

  log "=== Cert-Target: ${target_name} (${main_domain}) ==="

  local tmp_dir; tmp_dir=$(mktemp -d)
  # shellcheck disable=SC2064
  trap "rm -rf '${tmp_dir}'" RETURN

  cert_extract "$main_domain" "${tmp_dir}/cert.pem" "${tmp_dir}/key.pem" || return 1

  if [[ -n "$host" ]]; then
    # ── SSH-Deployment ─────────────────────────────────────────────────────
    info "Übertrage nach ${host} ..."
    # scp/ssh-Fehlschläge (z.B. Host nicht erreichbar) explizit prüfen —
    # sonst würde dank set -e-Sonderregel innerhalb von if-Bedingungen ein
    # fehlgeschlagener Transfer hier sonst stillschweigend als "unverändert"
    # durchgehen, statt als Fehler gemeldet zu werden.
    if ! scp -F /dev/null -q "${tmp_dir}/cert.pem" "root@${host}:${remote_cert}.new" \
        || ! scp -F /dev/null -q "${tmp_dir}/key.pem"  "root@${host}:${remote_key}.new"; then
      warn "Übertragung nach ${host} fehlgeschlagen — Target übersprungen"
      return 1
    fi

    local result
    if ! result=$(ssh -F /dev/null "root@${host}"       REMOTE_CERT="$remote_cert" REMOTE_KEY="$remote_key" FORCE="$force"       REMOTE_OWNER="$remote_owner" REMOTE_GROUP="$remote_group"       CERT_MODE="$cert_mode" KEY_MODE="$key_mode" MAIN_DOMAIN="$main_domain"       bash <<'REMOTE'
set -euo pipefail
changed=0
if ! cmp -s "${REMOTE_CERT}.new" "${REMOTE_CERT}" 2>/dev/null; then
  install -m "${CERT_MODE}" "${REMOTE_CERT}.new" "${REMOTE_CERT}"; changed=1
fi
if ! cmp -s "${REMOTE_KEY}.new" "${REMOTE_KEY}" 2>/dev/null; then
  install -m "${KEY_MODE}" "${REMOTE_KEY}.new" "${REMOTE_KEY}"; changed=1
fi
# Eigentümer setzen falls angegeben
if [[ -n "${REMOTE_OWNER}" || -n "${REMOTE_GROUP}" ]]; then
  chown "${REMOTE_OWNER}:${REMOTE_GROUP}" "${REMOTE_CERT}" "${REMOTE_KEY}" 2>/dev/null || true
fi
rm -f "${REMOTE_CERT}.new" "${REMOTE_KEY}.new"
# Mailcow legt für SNI pro Domain einen eigenen Cert-Pfad an
# (z.B. data/assets/ssl/<domain>/cert.pem), getrennt vom globalen Pfad
# oben — Dovecot/Postfix bevorzugen den bei einer SNI-Verbindung. Falls
# so ein Verzeichnis für main_domain existiert, per Symlink auf den
# gerade deployten globalen Cert verweisen, sonst bleibt dort dauerhaft
# ein eigenes, nie aktualisiertes Zertifikat aktiv.
dom_dir="$(dirname "${REMOTE_CERT}")/${MAIN_DOMAIN}"
if [[ -d "$dom_dir" ]]; then
  ln -sf "../$(basename "${REMOTE_CERT}")" "${dom_dir}/$(basename "${REMOTE_CERT}")"
  ln -sf "../$(basename "${REMOTE_KEY}")"  "${dom_dir}/$(basename "${REMOTE_KEY}")"
fi
[[ "$changed" -eq 1 || "$FORCE" -eq 1 ]] && echo "updated" || echo "unchanged"
REMOTE
    ); then
      warn "SSH-Verbindung zu ${host} fehlgeschlagen — Target übersprungen"
      return 1
    fi

    if [[ "$result" == "updated" ]]; then
      if [[ -n "$reload_cmd" ]]; then
        info "Reload auf ${host}: ${reload_cmd}"
        ssh -F /dev/null "root@${host}" "$reload_cmd" \
          || warn "Reload fehlgeschlagen (nicht kritisch)"
      fi
      info "Aktualisiert"
    elif [[ "$result" == "unchanged" ]]; then
      info "Unverändert — kein Neustart"
    else
      warn "Unerwartete Antwort von ${host}: '${result:-leer}' — Target übersprungen"
      return 1
    fi
  else
    # ── Lokales Deployment ─────────────────────────────────────────────────
    local changed=0
    if ! cmp -s "${tmp_dir}/cert.pem" "$remote_cert" 2>/dev/null; then
      install -m 0644 "${tmp_dir}/cert.pem" "$remote_cert"; changed=1
    fi
    if ! cmp -s "${tmp_dir}/key.pem" "$remote_key" 2>/dev/null; then
      install -m 0600 "${tmp_dir}/key.pem" "$remote_key"; changed=1
    fi
    if [[ $changed -eq 1 || $force -eq 1 ]]; then
      [[ -n "$reload_cmd" ]] && eval "$reload_cmd" || true
      info "Lokal deployt"
    else
      info "Lokal unverändert"
    fi
  fi

  # Nur an dieser Stelle erreicht wenn Extraktion + Deployment tatsächlich
  # erfolgreich waren — bei Fehlern oben ist die Funktion schon per
  # "return 1" raus, TLSA würde sonst auf einen noch nicht live
  # deployten Cert zeigen (DANE ist fail-closed, das wäre schlimmer als
  # gar kein DANE).
  [[ "$target_name" == "mailcow" ]] && publish_mailcow_tlsa "${tmp_dir}/cert.pem"
}

### ═══════════════════════════════════════════════════════════════════════════
### PFSENSE SPLIT-DNS (Unbound Host Overrides via XML-RPC)
###
### Kein Paket nötig — nutzt das eingebaute XML-RPC von pfSense CE.
### Zugangsdaten: normaler pfSense Admin-User + Passwort.
### ═══════════════════════════════════════════════════════════════════════════

pfsense_configured() {
  [[ -n "${PFSENSE_HOST:-}" && -n "${PFSENSE_USER:-}" && -n "${PFSENSE_PASS:-}" ]]
}

pfsense_exec_php() {
  # Führt PHP-Code auf pfSense via XML-RPC (pfsense.exec_php) aus.
  # Gibt die vom PHP-Code per echo ausgegebene Zeichenkette zurück.
  local php_code="$1"
  local result
  result=$(curl -sf -k -X POST \
    -H "Content-Type: text/xml" \
    --data-binary @- \
    "https://${PFSENSE_HOST}/xmlrpc.php" 2>/dev/null <<XMLEOF
<?xml version='1.0' encoding='utf-8'?>
<methodCall>
  <methodName>pfsense.exec_php</methodName>
  <params>
    <param><value><string><![CDATA[${PFSENSE_USER}]]></string></value></param>
    <param><value><string><![CDATA[${PFSENSE_PASS}]]></string></value></param>
    <param><value><string><![CDATA[${php_code}]]></string></value></param>
  </params>
</methodCall>
XMLEOF
  ) || return 1
  # Ausgabe aus XML-RPC Antwort extrahieren
  echo "$result" | grep -oP '(?<=<string>)[^<]+'
}

pfsense_set_override() {
  # pfsense_set_override <fqdn> <zone> <ip>
  local fqdn="$1" zone="$2" ip="$3"
  pfsense_configured || return 0

  local host_part domain_part
  [[ "$fqdn" == "$zone" ]] && host_part="" || host_part="${fqdn%.${zone}}"
  domain_part="$zone"

  local php_code="require_once('unbound.inc');
\$h='${host_part}'; \$d='${domain_part}'; \$ip='${ip}'; \$desc='dns-mgr: ${fqdn}';
if(!is_array(\$config['unbound']['hosts'])){\$config['unbound']['hosts']=array();}
\$found=false;
foreach(\$config['unbound']['hosts'] as \$k=>\$hh){
  if(\$hh['host']===\$h&&\$hh['domain']===\$d){\$config['unbound']['hosts'][\$k]['ip']=\$ip;\$found=true;break;}
}
if(!\$found){\$config['unbound']['hosts'][]=array('host'=>\$h,'domain'=>\$d,'ip'=>\$ip,'descr'=>\$desc,'aliases'=>array());}
write_config('dns-mgr');
services_unbound_configure(false);
echo 'ok';"

  local result
  result=$(pfsense_exec_php "$php_code") || {
    warn "pfSense nicht erreichbar — Split-DNS für ${fqdn} übersprungen"
    return 0
  }
  [[ "$result" == "ok" ]] \
    && info "pfSense Split-DNS: ${fqdn} → ${ip}" \
    || warn "pfSense Split-DNS: Override für ${fqdn} fehlgeschlagen (Antwort: ${result:-leer})"
}

pfsense_delete_override() {
  # pfsense_delete_override <fqdn> <zone>
  local fqdn="$1" zone="$2"
  pfsense_configured || return 0

  local host_part domain_part
  [[ "$fqdn" == "$zone" ]] && host_part="" || host_part="${fqdn%.${zone}}"
  domain_part="$zone"

  local php_code="require_once('unbound.inc');
\$h='${host_part}'; \$d='${domain_part}';
\$deleted=false;
if(is_array(\$config['unbound']['hosts'])){
  foreach(\$config['unbound']['hosts'] as \$k=>\$hh){
    if(\$hh['host']===\$h&&\$hh['domain']===\$d){unset(\$config['unbound']['hosts'][\$k]);\$deleted=true;}
  }
  \$config['unbound']['hosts']=array_values(\$config['unbound']['hosts']);
}
if(\$deleted){write_config('dns-mgr');services_unbound_configure(false);}
echo \$deleted?'deleted':'notfound';"

  local result
  result=$(pfsense_exec_php "$php_code") || {
    warn "pfSense nicht erreichbar — Split-DNS für ${fqdn} nicht gelöscht"
    return 0
  }
  case "$result" in
    deleted)  info "pfSense Split-DNS: ${fqdn} gelöscht" ;;
    notfound) info "pfSense Split-DNS: Kein Override für ${fqdn} gefunden" ;;
    *)        warn "pfSense Split-DNS: ${fqdn} löschen fehlgeschlagen" ;;
  esac
}

### ═══════════════════════════════════════════════════════════════════════════
### KOMMANDO: add-web
### ═══════════════════════════════════════════════════════════════════════════

cmd_add_web() {
  local domain="" with_mail=0
  local backend_ipv6="${TRAEFIK_IPV6}"

  for arg in "$@"; do
    case "$arg" in
      --mail)    with_mail=1 ;;
      --ipv6=*)  backend_ipv6="${arg#--ipv6=}" ;;
      *)         domain="$arg" ;;
    esac
  done
  [[ -z "$domain" ]] && die "add-web: Domain fehlt"

  local zone; zone=$(get_zone_for_domain "$domain")
  local is_subdomain=0

  if [[ -z "$zone" ]]; then
    create_zone "$domain"; set_ns_records "$domain"; zone="$domain"
  elif [[ "$zone" != "$domain" ]]; then
    is_subdomain=1; log "Subdomain ${domain} in Zone ${zone}"
  else
    log "Zone ${domain} existiert bereits"
  fi

  if [[ $is_subdomain -eq 1 ]]; then
    local sub="${domain%.${zone}}"
    set_record "$zone" "$sub"       "A"    "$PUBLIC_IPV4"
    set_record "$zone" "$sub"       "AAAA" "$backend_ipv6"
    set_record "$zone" "www.${sub}" "A"    "$PUBLIC_IPV4"
    set_record "$zone" "www.${sub}" "AAAA" "$backend_ipv6"
  else
    set_record "$zone" "@"   "A"    "$PUBLIC_IPV4"
    set_record "$zone" "@"   "AAAA" "$backend_ipv6"
    set_record "$zone" "www" "A"    "$PUBLIC_IPV4"
    set_record "$zone" "www" "AAAA" "$backend_ipv6"
  fi

  write_traefik_http "$(safe_name "$domain")" \
    "$domain" "www.${domain}" -- "http://${HESTIA_IP}:80"

  pfsense_set_override "$domain" "$zone" "$HESTIA_IP"

  [[ $with_mail -eq 1 ]] && cmd_add_mail_records "$domain"
  log "Web-Domain ${domain} eingerichtet"
}

### ═══════════════════════════════════════════════════════════════════════════
### KOMMANDO: add-mail
### ═══════════════════════════════════════════════════════════════════════════

cmd_add_mail_records() {
  local domain="$1"
  [[ -z "$domain" ]] && die "add-mail: Domain fehlt"

  local zone; zone=$(get_zone_for_domain "$domain")
  if [[ -z "$zone" ]]; then
    log "Zone für ${domain} nicht gefunden — lege Zone an"
    create_zone "$domain"; set_ns_records "$domain"
    set_record "$domain" "@" "A"    "$PUBLIC_IPV4"
    set_record "$domain" "@" "AAAA" "$(ipv6_addr "::120")"
    zone="$domain"
  fi

  log "Setze Mail-DNS-Records für ${domain}"

  for sub in mail autoconfig autodiscover webmail mta-sts; do
    set_record "$zone" "$sub" "A"    "$PUBLIC_IPV4"
    set_record "$zone" "$sub" "AAAA" "$MAILCOW_IPV6"
  done

  set_record "$zone" "@" "MX" "10 mail.${domain}." 3600

  # SPF gehört auf den Apex (@), nicht auf mail.*
  set_record "$zone" "@" "TXT" \
    "\"v=spf1 mx ip4:${PUBLIC_IPV4} ip6:${MAILCOW_IPV6} -all\""

  local dkim_key
  dkim_key=$(curl -sfk -H "X-API-Key: ${MAILCOW_KEY}" \
    "${MAILCOW_API}/get/dkim/${domain}" \
    | jq -r '.dkim_txt // empty' 2>/dev/null) || true
  if [[ -n "$dkim_key" ]]; then
    # Mailcow liefert dkim_txt bereits als kompletten TXT-Content
    # (z.B. "v=DKIM1; k=rsa; p=...") — nur Anführungszeichen drum
    # Falls der Key schon mit v=DKIM1 beginnt direkt nutzen, sonst Prefix ergänzen
    if [[ "$dkim_key" == v=DKIM1* ]]; then
      set_record "$zone" "dkim._domainkey" "TXT" "\"${dkim_key}\""
    else
      set_record "$zone" "dkim._domainkey" "TXT" "\"v=DKIM1; k=rsa; t=s; s=email; p=${dkim_key}\""
    fi
    info "DKIM-Record gesetzt"
  else
    warn "DKIM-Key von Mailcow nicht erhalten — bitte manuell nachtragen"
    info "Abruf: curl -H 'X-API-Key: KEY' ${MAILCOW_API}/get/dkim/${domain}"
  fi

  set_record "$zone" "_dmarc" "TXT" \
    "\"v=DMARC1; p=reject; rua=mailto:postmaster@${domain}; adkim=s; aspf=s\""

  local mta_sts_id; mta_sts_id=$(get_mta_sts_id "$domain")
  set_record "$zone" "_mta-sts" "TXT" "\"v=STSv1;id=${mta_sts_id};\""

  set_record "$zone" "_smtp._tls" "TXT" \
    "\"v=TLSRPTv1; rua=mailto:tlsrpt@${domain}\""

  set_record "$zone" "_autodiscover._tcp" "SRV" "0 1 443 mail.${domain}." 3600

  # Individuelle Route pro Domain (wird in SAN-Route zusammengefasst, dient
  # rebuild_mailcow_san_route zugleich als Datenquelle fuer die SAN-Liste)
  write_traefik_http "mail-$(safe_name "$domain")" \
    "mail.${domain}" "webmail.${domain}" \
    "autoconfig.${domain}" "autodiscover.${domain}" "mta-sts.${domain}" \
    -- "https://${MAILCOW_IP}:443" --insecure

  # Gemeinsames SAN-Zertifikat für alle Mail-Domains neu aufbauen
  rebuild_mailcow_san_route

  log "Mail-Records für ${domain} eingerichtet"
  log ""
  log "══ PTR-Records — manuell im Hetzner Robot setzen ══════════════════════"
  log "   URL: https://robot.hetzner.com → Server → IPs → Reverse DNS"
  log "   IPv4: ${PUBLIC_IPV4}  →  ${MAIL_HOSTNAME}"
  log "   IPv6: ${MAILCOW_IPV6}  →  ${MAIL_HOSTNAME}"
  log "═══════════════════════════════════════════════════════════════════════"
}

### ═══════════════════════════════════════════════════════════════════════════
### KOMMANDO: add-service
### ═══════════════════════════════════════════════════════════════════════════

cmd_add_service() {
  local domain="" backend_ip="" backend_port=""
  local type="http" tcp_listen_port="" custom_ipv6="" no_dns=0 no_ipv6=0 insecure=0 no_traefik=0 explicit_zone=""
  local prefix="" strip_prefix="" basic_auth="" redirect_url="" internal=0
  local extra_paths=()  # Array von "pfad:ip:port[:insecure]"

  for arg in "$@"; do
    case "$arg" in
      --type=*)            type="${arg#--type=}" ;;
      --tcp-listen-port=*) tcp_listen_port="${arg#--tcp-listen-port=}" ;;
      --ipv6=*)            custom_ipv6="${arg#--ipv6=}" ;;
      --no-dns)            no_dns=1 ;;
      --no-ipv6)           no_ipv6=1 ;;
      --no-traefik)        no_traefik=1 ;;
      --insecure)          insecure=1 ;;
      --internal)          internal=1; no_traefik=1 ;;
      --subdomain-of=*)    explicit_zone="${arg#--subdomain-of=}" ;;
      --prefix=*)          prefix="${arg#--prefix=}" ;;
      --strip-prefix=*)    strip_prefix="${arg#--strip-prefix=}" ;;
      --basic-auth=*)      basic_auth="${arg#--basic-auth=}" ;;
      --redirect=*)        redirect_url="${arg#--redirect=}" ;;
      --extra-path=*)      extra_paths+=("${arg#--extra-path=}") ;;
      *)
        if   [[ -z "$domain"       ]]; then domain="$arg"
        elif [[ -z "$backend_ip"   ]]; then backend_ip="$arg"
        elif [[ -z "$backend_port" ]]; then backend_port="$arg"
        fi ;;
    esac
  done

  [[ -z "$domain"       ]] && die "add-service: Domain fehlt"
  [[ -z "$backend_ip"   ]] && die "add-service: Backend-IP fehlt"
  [[ -z "$backend_port" ]] && die "add-service: Backend-Port fehlt"

  local target_ipv6
  if [[ -n "$custom_ipv6" ]]; then
    if   [[ "$custom_ipv6" == ::* ]];       then target_ipv6=$(ipv6_addr "$custom_ipv6")
    elif [[ "$custom_ipv6" =~ ^[0-9]+$ ]];  then target_ipv6=$(ipv6_from_ctid "$custom_ipv6")
    else                                          target_ipv6="$custom_ipv6"
    fi
  else
    local last_octet="${backend_ip##*.}"
    target_ipv6=$(ipv6_from_ctid "$last_octet")
    warn "IPv6 aus IP abgeleitet: ${target_ipv6} — bei Bedarf --ipv6=::CTID angeben"
  fi

  local svc_name; svc_name=$(safe_name "$domain")

  # Bei --internal: DNS zeigt auf interne Backend-IP statt PUBLIC_IPV4
  local dns_ipv4="$PUBLIC_IPV4"
  [[ $internal -eq 1 ]] && dns_ipv4="$backend_ip"

  if [[ $no_dns -eq 0 ]]; then
    local zone="${explicit_zone:-$(get_zone_for_domain "$domain")}"
    if [[ -z "$zone" ]]; then
      create_zone "$domain"; set_ns_records "$domain"; zone="$domain"
      set_record "$zone" "@" "A" "$dns_ipv4"
      [[ $no_ipv6 -eq 0 && $internal -eq 0 ]] && set_record "$zone" "@" "AAAA" "$target_ipv6"
    elif [[ "$zone" == "$domain" ]]; then
      set_record "$zone" "@" "A" "$dns_ipv4"
      [[ $no_ipv6 -eq 0 && $internal -eq 0 ]] && set_record "$zone" "@" "AAAA" "$target_ipv6"
    else
      local sub="${domain%.${zone}}"
      set_record "$zone" "$sub" "A" "$dns_ipv4"
      [[ $no_ipv6 -eq 0 && $internal -eq 0 ]] && set_record "$zone" "$sub" "AAAA" "$target_ipv6"
    fi
  fi

  local insecure_flag=""
  [[ $insecure -eq 1 ]] && insecure_flag="--insecure"

  if [[ $no_traefik -eq 1 ]]; then
    log "Traefik übersprungen (--no-traefik) — Dienst läuft direkt per NAT"
  elif [[ "$type" == "tcp" ]]; then
    [[ -z "$tcp_listen_port" ]] && die "TCP benötigt --tcp-listen-port=<port>"
    write_traefik_tcp "$svc_name" "${backend_ip}:${backend_port}" "$tcp_listen_port"
  else
    local backend_url="http://${backend_ip}:${backend_port}"
    [[ $insecure -eq 1 ]] && backend_url="https://${backend_ip}:${backend_port}"
    local extra_flags=""
    [[ -n "$prefix"       ]] && extra_flags+=" --prefix=${prefix}"
    [[ -n "$strip_prefix" ]] && extra_flags+=" --strip-prefix=${strip_prefix}"
    [[ -n "$basic_auth"   ]] && extra_flags+=" --basic-auth=${basic_auth}"
    [[ -n "$redirect_url" ]] && extra_flags+=" --redirect=${redirect_url}"
    write_traefik_http "$svc_name" "$domain" -- "$backend_url" $insecure_flag $extra_flags
  fi

  # --extra-path: zusätzliche Pfade mit separatem Backend zur bestehenden Route hinzufügen
  # Format: --extra-path=/pfad:ip:port[:insecure]
  # Beispiel: --extra-path=/phpmyadmin:192.168.1.118:80
  if [[ ${#extra_paths[@]} -gt 0 ]]; then
    local yml_file="${TRAEFIK_CONF_DIR}/${svc_name}.yml"
    for ep in "${extra_paths[@]}"; do
      local ep_path ep_ip ep_port ep_insecure=0
      IFS=: read -r ep_path ep_ip ep_port ep_ins <<< "$ep"
      [[ "${ep_ins:-}" == "insecure" ]] && ep_insecure=1
      local ep_name="${svc_name}-$(echo "${ep_path//\//-}" | tr -d '-' | head -c 20)"
      local ep_url="http://${ep_ip}:${ep_port}"
      [[ $ep_insecure -eq 1 ]] && ep_url="https://${ep_ip}:${ep_port}"
      local ep_transport=""
      [[ $ep_insecure -eq 1 ]] && ep_transport="
        serversTransport: insecure"

      log "Extra-Pfad: ${domain}${ep_path} → ${ep_url}"
      cat >> "$yml_file" <<EOF

    ${ep_name}:
      rule: "Host(\`${domain}\`) && PathPrefix(\`${ep_path}\`)"
      entryPoints: [websecure]
      tls:
        certResolver: ${ACME_RESOLVER}
      service: ${ep_name}
  services:
    ${ep_name}:
      loadBalancer:
        servers:
          - url: "${ep_url}"${ep_transport}
EOF
    done
  fi

  if pfsense_configured && [[ $no_dns -eq 0 && $internal -eq 0 ]]; then
    pfsense_set_override "$domain" "${zone:-$domain}" "$backend_ip"
  fi

  local ipv6_info="${target_ipv6}"
  [[ $no_ipv6 -eq 1 || $internal -eq 1 ]] && ipv6_info="(intern: ${backend_ip})"
  local traefik_info=""
  [[ $no_traefik -eq 1 && $internal -eq 0 ]] && traefik_info=" (kein Traefik — direkt per NAT)"
  [[ $internal -eq 1 ]] && traefik_info=" (intern — nur über VPN erreichbar)"
  log "Dienst ${domain} eingerichtet (${type}) → ${backend_ip}:${backend_port} | IPv6: ${ipv6_info}${traefik_info}"
}


### ═══════════════════════════════════════════════════════════════════════════
### KOMMANDO: add-srv
### Generischer SRV-Record anlegen
### ═══════════════════════════════════════════════════════════════════════════

cmd_add_srv() {
  # add-srv <zone> <service> <proto> <priority> <weight> <port> <target>
  # Beispiel: dns-mgr add-srv nfsmw15.de mumble tcp 0 10 64739 mumble.nfsmw15.de
  local zone="${1:-}" service="${2:-}" proto="${3:-tcp}"
  local priority="${4:-0}" weight="${5:-10}" port="${6:-}" target="${7:-}"

  [[ -z "$zone"    ]] && die "add-srv: Zone fehlt"
  [[ -z "$service" ]] && die "add-srv: Service fehlt (z.B. mumble, sip, xmpp)"
  [[ -z "$port"    ]] && die "add-srv: Port fehlt"
  [[ -z "$target"  ]] && die "add-srv: Target-Hostname fehlt"

  # Target muss mit Punkt enden (FQDN)
  [[ "$target" != *. ]] && target="${target}."

  local srv_name="_${service}._${proto}.${zone}."
  local srv_content="${priority} ${weight} ${port} ${target}"

  log "SRV-Record: ${srv_name} → ${srv_content}"

  local payload
  payload=$(jq -n \
    --arg name    "$srv_name" \
    --arg content "$srv_content" \
    '{rrsets:[{name:$name,type:"SRV",ttl:300,changetype:"REPLACE",
       records:[{content:$content,disabled:false}]}]}')

  pdns_patch "/servers/localhost/zones/${zone}." "$payload" \
    && log "SRV-Record gesetzt" \
    || warn "SRV-Record fehlgeschlagen"
}

### ═══════════════════════════════════════════════════════════════════════════
### KOMMANDO: enable-dnssec
### Aktiviert DNSSEC-Signing für eine Zone und gibt DNSKEY- und DS-Record zum
### manuellen Eintrag beim Registrar aus. PowerDNS rotiert Keys nicht von
### selbst — die Records müssen daher nur einmalig gesetzt werden, es sei
### denn es wird spaeter manuell ein Key-Rollover durchgefuehrt.
### ═══════════════════════════════════════════════════════════════════════════

cmd_enable_dnssec() {
  local domain="${1:-}"
  [[ -z "$domain" ]] && die "enable-dnssec: Domain fehlt"

  local zone; zone=$(get_zone_for_domain "$domain")
  [[ -z "$zone" ]] && die "Keine PowerDNS-Zone für ${domain} gefunden"

  local keys
  keys=$(pdns_get "/servers/localhost/zones/${zone}./cryptokeys") \
    || die "PowerDNS-API: Cryptokeys für ${zone} konnten nicht abgerufen werden"

  local active_signing
  active_signing=$(echo "$keys" \
    | jq -r '.[] | select(.active==true and (.keytype=="csk" or .keytype=="ksk"))')

  if [[ -z "$active_signing" ]]; then
    log "Aktiviere DNSSEC für ${zone} (CSK, ECDSAP256SHA256) ..."
    keys=$(pdns_post "/servers/localhost/zones/${zone}./cryptokeys" \
      '{"keytype":"csk","active":true,"algorithm":"ECDSAP256SHA256"}') \
      || die "DNSSEC-Key für ${zone} konnte nicht angelegt werden"
    # Einzelnes Cryptokey-Objekt (POST-Antwort) in ein Array packen,
    # damit der jq-Filter unten fuer beide Faelle gleich funktioniert
    keys="[${keys}]"
  else
    log "DNSSEC für ${zone} bereits aktiv — zeige vorhandene Records erneut"
  fi

  # PowerDNS liefert dnskey/ds nur als reine RDATA (ohne Owner/TTL/Class/Type) —
  # fuers Copy-Paste beim Registrar (z.B. INWX-Formular) muss das volle
  # Presentation-Format davorgesetzt werden.
  local dnskey_records ds_records
  dnskey_records=$(echo "$keys" \
    | jq -r '.[] | select(.active==true and (.keytype=="csk" or .keytype=="ksk")) | .dnskey')
  ds_records=$(echo "$keys" \
    | jq -r '.[] | select(.active==true and (.keytype=="csk" or .keytype=="ksk")) | .ds[]?')

  [[ -z "$dnskey_records" ]] && die "Kein DNSKEY von PowerDNS erhalten — Zone/Key manuell prüfen"

  log ""
  log "══ DNSSEC-Records für ${zone} — beim Registrar eintragen (z.B. INWX → Domain → DNSSEC) ══"
  log "DNSKEY RR (primär — die meisten Registrare, u.a. INWX, berechnen den DS-Record daraus):"
  while IFS= read -r dnskey; do
    log "   ${zone}. 3600 IN DNSKEY ${dnskey}"
  done <<< "$dnskey_records"
  log ""
  log "DS Record (falls der Registrar stattdessen/zusätzlich den DS will):"
  while IFS= read -r ds; do
    log "   ${zone}. 3600 IN DS ${ds}"
  done <<< "$ds_records"
  log "═══════════════════════════════════════════════════════════════════════════════════"
  log "Hinweis: PowerDNS rotiert Keys nicht automatisch — die Records bleiben stabil,"
  log "solange kein manuelles Key-Rollover durchgeführt wird."
}

### ═══════════════════════════════════════════════════════════════════════════
### KOMMANDO: fix-soa
### Korrigiert die SOA einer bestehenden Zone auf den konfigurierten Wert.
### Für Zonen, die nicht über cmd_create_zone entstanden sind (z.B. vorher
### schon manuell angelegt) und daher noch PowerDNS' Platzhalter-SOA tragen
### ("a.misconfigured.dns.server.invalid.").
### ═══════════════════════════════════════════════════════════════════════════

cmd_fix_soa() {
  local domain="${1:-}"
  [[ -z "$domain" ]] && die "fix-soa: Domain fehlt"

  local zone; zone=$(get_zone_for_domain "$domain")
  [[ -z "$zone" ]] && die "Keine PowerDNS-Zone für ${domain} gefunden"

  log "Korrigiere SOA für ${zone} (MNAME: ${NS_RECORDS[0]}) ..."
  set_record "$zone" "@" "SOA" \
    "${NS_RECORDS[0]} ${SOA_HOSTMASTER} $(date +%Y%m%d01) 3600 900 604800 300" 3600
  log "SOA für ${zone} korrigiert"
}

### ═══════════════════════════════════════════════════════════════════════════
### KOMMANDO: remove
### ═══════════════════════════════════════════════════════════════════════════

cmd_remove() {
  local domain="${1:-}" force=0
  [[ "${2:-}" == "--force" ]] && force=1
  [[ -z "$domain" ]] && die "remove: Domain fehlt"

  # URL bereinigen — http(s):// und trailing / entfernen
  domain="${domain#https://}"
  domain="${domain#http://}"
  domain="${domain%/}"

  if [[ $force -eq 0 ]]; then
    read -r -p "Zone ${domain} und Traefik-Config löschen? [j/N] " confirm
    [[ "$confirm" != "j" && "$confirm" != "J" ]] && { log "Abgebrochen"; exit 0; }
  fi

  # Split-DNS Override vor Zone-Löschung entfernen (Zone wird noch für Lookup benötigt)
  if pfsense_configured; then
    local rm_zone; rm_zone=$(get_zone_for_domain "$domain")
    [[ -z "$rm_zone" ]] && rm_zone="$domain"
    pfsense_delete_override "$domain" "$rm_zone"
  fi

  if zone_exists "$domain"; then
    pdns_delete_zone "$domain"; log "Zone ${domain} gelöscht"
  else
    log "Zone ${domain} nicht gefunden"
  fi

  remove_traefik_config "$(safe_name "$domain")"
  remove_traefik_config "mail-$(safe_name "$domain")"
  remove_traefik_config "mta-sts-$(safe_name "$domain")"
  rebuild_mailcow_san_route
  log "Domain ${domain} entfernt"
}

### ═══════════════════════════════════════════════════════════════════════════
### KOMMANDO: mailcow-sync
### ═══════════════════════════════════════════════════════════════════════════

cmd_mailcow_sync() {
  log "Mailcow-Domain-Sync"
  mkdir -p "$STATE_DIR"
  [[ -f "$MAILCOW_STATE" ]] || echo "[]" > "$MAILCOW_STATE"

  # Verbindungstest
  local http_code
  http_code=$(curl -sk -o /dev/null -w "%{http_code}" \
    -H "X-API-Key: ${MAILCOW_KEY}" "${MAILCOW_API}/get/domain/all") || true
  case "$http_code" in
    000) die "Mailcow nicht erreichbar (${MAILCOW_IP}) — LXC online?" ;;
    401) die "Mailcow-API: falscher Key — MAILCOW_KEY in dns-mgr.conf prüfen" ;;
  esac

  local current_domains
  current_domains=$(curl -sfk -H "X-API-Key: ${MAILCOW_KEY}" \
    "${MAILCOW_API}/get/domain/all" \
    | jq '[.[].domain_name]' 2>/dev/null) \
    || die "Mailcow-API: ungültige Antwort"

  local new_domains
  new_domains=$(jq -rn \
    --argjson cur "$current_domains" \
    --argjson known "$(cat "$MAILCOW_STATE")" \
    '($cur - $known)[]')

  if [[ -z "$new_domains" ]]; then
    log "Keine neuen Mailcow-Domains"
    echo "$current_domains" > "$MAILCOW_STATE"
    return 0
  fi

  while IFS= read -r domain; do
    [[ -z "$domain" ]] && continue
    log "Neue Mailcow-Domain: ${domain}"
    if zone_exists "$domain"; then
      cmd_add_mail_records "$domain"
    else
      cmd_add_web "$domain"
      cmd_add_mail_records "$domain"
    fi
  done <<< "$new_domains"

  echo "$current_domains" > "$MAILCOW_STATE"
  log "Mailcow-Sync abgeschlossen"
}

### ═══════════════════════════════════════════════════════════════════════════
### KOMMANDO: update-mta-sts
### ═══════════════════════════════════════════════════════════════════════════

cmd_update_mta_sts() {
  log "MTA-STS IDs aus Mailcow-Datenbank aktualisieren"

  # DB-Zugangsdaten von Mailcow-Host lesen
  local dbpass
  dbpass=$(ssh root@"${MAILCOW_IP}" \
    "grep DBPASS /opt/mailcow-dockerized/mailcow.conf | cut -d= -f2") \
    || die "SSH zu ${MAILCOW_IP} fehlgeschlagen"

  # Alle MTA-STS Eintraege aus der DB lesen
  local db_result
  db_result=$(ssh root@"${MAILCOW_IP}" \
    "docker compose -f /opt/mailcow-dockerized/docker-compose.yml exec -T mysql-mailcow \
      mysql -u mailcow -p${dbpass} mailcow \
      -sN -e 'SELECT domain, id FROM mta_sts WHERE active=1;' 2>/dev/null") \
    || die "DB-Abfrage fehlgeschlagen"

  local updated=0
  while IFS=$'\t' read -r domain mta_sts_id; do
    [[ -z "$domain" || "$domain" == "domain" ]] && continue

    local zone="$domain"

    # Aktuellen Record in PowerDNS lesen
    local current
    current=$(curl -s -H "X-API-Key: ${PDNS_KEY}" \
      "${PDNS_API}/servers/localhost/zones/${zone}." \
      | jq -r '.rrsets[] | select(.name == "_mta-sts.'"${zone}"'.") | .records[0].content' 2>/dev/null) || true

    local expected="\"v=STSv1;id=${mta_sts_id};\""

    if [[ "$current" == "$expected" ]]; then
      info "${domain}: MTA-STS ID bereits korrekt (${mta_sts_id})"
      continue
    fi

    log "${domain}: MTA-STS ID aktualisieren: ${mta_sts_id}"
    set_record "$zone" "_mta-sts" "TXT" "\"v=STSv1;id=${mta_sts_id};\""

    # State-Datei aktualisieren
    mkdir -p "$STATE_DIR"
    [[ -f "$MTA_STS_STATE" ]] || echo "{}" > "$MTA_STS_STATE"
    local tmp; tmp=$(mktemp)
    jq --arg d "$domain" --arg id "$mta_sts_id" '.[$d] = $id' "$MTA_STS_STATE" > "$tmp"
    mv "$tmp" "$MTA_STS_STATE"

    (( updated++ )) || true
  done <<< "$db_result"

  log "MTA-STS Update abgeschlossen — ${updated} Domain(s) aktualisiert"
}


### KOMMANDO: deploy-certs
### ═══════════════════════════════════════════════════════════════════════════

cmd_deploy_certs() {
  local filter_target="" force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target) filter_target="$2"; shift 2 ;;
      --force)  force=1; shift ;;
      *) die "deploy-certs: unbekannter Parameter '$1'" ;;
    esac
  done

  [[ ! -f "$ACME_JSON" ]] && die "acme.json nicht gefunden: ${ACME_JSON}"

  local total=0 success=0 skipped=0
  for target_name in "${!CERT_TARGETS[@]}"; do
    [[ -n "$filter_target" && "$target_name" != "$filter_target" ]] && continue
    (( total++ )) || true
    if cert_deploy_target "$target_name" "$force"; then
      (( success++ )) || true
    else
      (( skipped++ )) || true
    fi
  done
  log "Fertig: ${success}/${total} erfolgreich, ${skipped} übersprungen"
}

### ═══════════════════════════════════════════════════════════════════════════
### KOMMANDO: watch-certs  (läuft dauerhaft als systemd-Service)
### ═══════════════════════════════════════════════════════════════════════════

cmd_watch_certs() {
  local settle=15
  [[ "${1:-}" == --settle=* ]] && settle="${1#--settle=}"

  command -v inotifywait &>/dev/null \
    || die "inotifywait fehlt: apt install inotify-tools"
  [[ ! -f "$ACME_JSON" ]] && die "acme.json nicht gefunden: ${ACME_JSON}"

  log "Überwache ${ACME_JSON} (settle: ${settle}s) ..."

  # ACME-Clients (Traefik/lego) schreiben acme.json atomar: zuerst wird eine
  # Temp-Datei geschrieben (löst close_write auf den Temp-Dateinamen aus),
  # anschließend per rename() auf den finalen Dateinamen verschoben (löst
  # moved_to aus, NICHT close_write). Ohne moved_to in der Event-Liste wird
  # dieses entscheidende Event nie empfangen und watch-certs reagiert nie auf
  # neue Zertifikate — close_write allein reicht hier nicht aus.
  inotifywait -m -e close_write,moved_to --format '%f' "$(dirname "$ACME_JSON")" \
  | while IFS= read -r filename; do
      [[ "$filename" != "$(basename "$ACME_JSON")" ]] && continue
      log "acme.json geändert — warte ${settle}s ..."
      sleep "$settle"
      # Während der Settle-Zeit angesammelte Folge-Events (z.B. wenn sowohl
      # close_write als auch moved_to auf den finalen Dateinamen passen)
      # verwerfen, damit nicht mehrfach hintereinander deployed wird.
      while read -r -t 0.1 _; do :; done
      log "Starte deploy-certs ..."
      if cmd_deploy_certs; then
        log "deploy-certs erfolgreich"
      else
        warn "deploy-certs mit Fehler beendet"
      fi
    done
}

### ═══════════════════════════════════════════════════════════════════════════
### KOMMANDO: cert-list
### ═══════════════════════════════════════════════════════════════════════════

cmd_cert_list() {
  echo ""
  echo "Konfigurierte Cert-Targets (in CERT_TARGETS):"
  printf "  %-15s  %-35s  %s\n" "NAME" "MAIN-DOMAIN" "HOST"
  printf "  %-15s  %-35s  %s\n" "----" "-----------" "----"
  for name in "${!CERT_TARGETS[@]}"; do
    IFS=':' read -r host _ _ _ domain <<< "${CERT_TARGETS[$name]}"
    printf "  %-15s  %-35s  %s\n" "$name" "$domain" "${host:-lokal}"
  done

  echo ""
  echo "Zertifikate in acme.json:"
  if [[ ! -f "$ACME_JSON" ]]; then
    echo "  acme.json nicht gefunden: ${ACME_JSON}"
  else
    local certs
    certs=$(jq -r --arg r "$ACME_RESOLVER" \
      '.[$r].Certificates // [] | length' \
      "$ACME_JSON" 2>/dev/null || echo "0")
    if [[ "$certs" == "0" || "$certs" == "null" || -z "$certs" ]]; then
      echo "  Noch keine Zertifikate ausgestellt"
      echo "  (werden nach der ersten Domain-Umschaltung automatisch erstellt)"
    else
      jq -r --arg r "$ACME_RESOLVER" \
        '.[$r].Certificates[] |
         "  \(.domain.main)\n    SANs: \(.domain.sans // [] | join(", "))"' \
        "$ACME_JSON" 2>/dev/null
    fi
  fi
}


# atomic_write_traefik <ziel-datei>  (Inhalt via stdin/Heredoc)
# Schreibt in eine Temp-Datei im selben Verzeichnis, validiert YAML falls
# moeglich und ersetzt die Zieldatei per mv (atomarer rename) — verhindert
# dass Traefiks fsnotify-Watcher (watch: true) eine angeschnittene Datei liest.
atomic_write_traefik() {
  local target="$1"
  local tmp; tmp=$(mktemp "${target}.XXXXXX")
  cat > "$tmp"
  if command -v python3 &>/dev/null && python3 -c 'import yaml' 2>/dev/null; then
    if ! python3 -c 'import sys, yaml; yaml.safe_load(open(sys.argv[1]))' "$tmp" 2>/dev/null; then
      rm -f "$tmp"
      die "Ungültiges YAML für ${target} generiert — Abbruch, bestehende Config bleibt aktiv"
    fi
  fi
  chmod 644 "$tmp"
  mv -f "$tmp" "$target"
}

write_traefik_http() {
  # write_traefik_http <service-name> <domain> [domain2 ...] -- <backend-url> [optionen]
  # --insecure:              Backend-Zertifikat nicht prüfen (pfSense, Proxmox etc.)
  # --prefix=/pfad:          Pfad dem Request voranstellen (z.B. /phpmyadmin)
  # --strip-prefix=/pfad:    Pfad aus dem Request entfernen bevor er ans Backend geht
  # --basic-auth=user:hash:  HTTP Basic Authentication (Passwort als htpasswd-Hash)
  # --redirect=https://ziel: URL-Weiterleitung
  local service_name="$1"; shift
  local domains=() backend_url="" sep=0 insecure=0
  local prefix="" strip_prefix="" basic_auth="" redirect_url=""

  for arg in "$@"; do
    if [[ "$arg" == "--" ]];             then sep=1; continue; fi
    if [[ "$arg" == "--insecure" ]];     then insecure=1; continue; fi
    if [[ "$arg" == --prefix=* ]];       then prefix="${arg#--prefix=}"; continue; fi
    if [[ "$arg" == --strip-prefix=* ]]; then strip_prefix="${arg#--strip-prefix=}"; continue; fi
    if [[ "$arg" == --basic-auth=* ]];   then basic_auth="${arg#--basic-auth=}"; continue; fi
    if [[ "$arg" == --redirect=* ]];     then redirect_url="${arg#--redirect=}"; continue; fi
    [[ $sep -eq 0 ]] && domains+=("$arg") || backend_url="$arg"
  done
  [[ -z "$backend_url" ]] && die "write_traefik_http: Backend-URL fehlt"

  local rule="Host(\`${domains[0]}\`)"
  for (( i=1; i<${#domains[@]}; i++ )); do
    rule+=" || Host(\`${domains[$i]}\`)"
  done

  # Middlewares zusammenstellen
  local middlewares="https-forward"
  [[ -n "${HSTS_MAX_AGE:-}" ]] && middlewares+=", hsts"
  local middleware_block=""

  local transport_line=""
  [[ $insecure -eq 1 ]] && transport_line="        serversTransport: insecure"

  if [[ -n "$prefix" ]]; then
    middlewares+=", ${service_name}-prefix"
    middleware_block+="
    ${service_name}-prefix:
      addPrefix:
        prefix: ${prefix}"
  fi

  if [[ -n "$strip_prefix" ]]; then
    middlewares+=", ${service_name}-strip"
    middleware_block+="
    ${service_name}-strip:
      stripPrefix:
        prefixes:
          - ${strip_prefix}"
  fi

  if [[ -n "$basic_auth" ]]; then
    middlewares+=", ${service_name}-auth"
    middleware_block+="
    ${service_name}-auth:
      basicAuth:
        users:
          - \"${basic_auth}\""
  fi

  if [[ -n "$redirect_url" ]]; then
    middlewares+=", ${service_name}-redirect"
    middleware_block+="
    ${service_name}-redirect:
      redirectRegex:
        regex: \".*\"
        replacement: \"${redirect_url}\""
  fi

  local middlewares_yaml="[${middlewares}]"
  local middlewares_section=""
  if [[ -n "$middleware_block" ]]; then
    middlewares_section="  middlewares:${middleware_block}"
  fi

  log "Traefik HTTP: ${service_name} → ${backend_url}$([ $insecure -eq 1 ] && echo ' (insecure)')$([ -n "$prefix" ] && echo " (prefix: ${prefix})")$([ -n "$strip_prefix" ] && echo " (strip: ${strip_prefix})")$([ -n "$basic_auth" ] && echo ' (basic-auth)')$([ -n "$redirect_url" ] && echo " (redirect: ${redirect_url})")"

  atomic_write_traefik "${TRAEFIK_CONF_DIR}/${service_name}.yml" <<EOF
http:
  routers:
    ${service_name}:
      rule: "${rule}"
      entryPoints: [websecure]
      tls:
        certResolver: ${ACME_RESOLVER}
      middlewares: ${middlewares_yaml}
      service: ${service_name}
${middlewares_section}
  services:
    ${service_name}:
      loadBalancer:
        servers:
          - url: "${backend_url}"
${transport_line}
EOF
}

write_traefik_http_san() {
  # write_traefik_http_san <service-name> <main-domain> <san1> [san2...] -- <backend-url> [--insecure]
  # Erstellt eine Route mit explizitem SAN-Zertifikat (für Mailcow multi-domain)
  local service_name="$1" main_domain="$2"; shift 2
  local sans=() backend_url="" sep=0 insecure=0
  for arg in "$@"; do
    if [[ "$arg" == "--" ]];         then sep=1; continue; fi
    if [[ "$arg" == "--insecure" ]]; then insecure=1; continue; fi
    [[ $sep -eq 0 ]] && sans+=("$arg") || backend_url="$arg"
  done
  [[ -z "$backend_url" ]] && die "write_traefik_http_san: Backend-URL fehlt"

  local rule="Host(\`${main_domain}\`)"
  for san in "${sans[@]}"; do rule+=" || Host(\`${san}\`)"; done

  local sans_yaml=""
  for san in "${sans[@]}"; do sans_yaml+="              - ${san}"$'\n'; done

  # Gleiche Middlewares wie write_traefik_http, damit Einzelrouter
  # (mail-<domain>) und diese SAN-Sammelroute sich identisch verhalten —
  # unabhaengig davon welcher der beiden Router bei Traefik den Zuschlag
  # bekommt (laengere rule gewinnt i.d.R., das ist hier die SAN-Route).
  local middlewares="https-forward"
  [[ -n "${HSTS_MAX_AGE:-}" ]] && middlewares+=", hsts"
  local middlewares_yaml="[${middlewares}]"

  local transport_line=""
  [[ $insecure -eq 1 ]] && transport_line="        serversTransport: insecure"

  log "Traefik SAN-Route: ${service_name} → ${backend_url}$([ $insecure -eq 1 ] && echo ' (insecure)') (main: ${main_domain}, ${#sans[@]} SANs)"
  atomic_write_traefik "${TRAEFIK_CONF_DIR}/${service_name}.yml" <<EOF
http:
  routers:
    ${service_name}:
      rule: "${rule}"
      entryPoints: [websecure]
      tls:
        certResolver: ${ACME_RESOLVER}
        domains:
          - main: ${main_domain}
            sans:
${sans_yaml}      middlewares: ${middlewares_yaml}
      service: ${service_name}
  services:
    ${service_name}:
      loadBalancer:
        servers:
          - url: "${backend_url}"
        passHostHeader: true
${transport_line}
EOF
}

write_traefik_tcp() {
  local service_name="$1" backend_addr="$2" listen_port="$3"
  log "Traefik TCP: ${service_name} → ${backend_addr} (Port ${listen_port})"
  cat > "${TRAEFIK_CONF_DIR}/${service_name}-tcp.yml" <<EOF
tcp:
  routers:
    ${service_name}-tcp:
      entryPoints: ["${service_name}-ep"]
      rule: "HostSNI(\`*\`)"
      service: ${service_name}-tcp
  services:
    ${service_name}-tcp:
      loadBalancer:
        servers:
          - address: "${backend_addr}"
EOF
  warn "Entrypoint '${service_name}-ep' (Port ${listen_port}) muss in traefik.yml eingetragen sein"
}

remove_traefik_config() {
  for f in "${TRAEFIK_CONF_DIR}/${1}.yml" "${TRAEFIK_CONF_DIR}/${1}-tcp.yml"; do
    [[ -f "$f" ]] && rm -f "$f" && log "Traefik-Config gelöscht: ${f}"
  done
}

write_hsts_middleware() {
  [[ -z "${HSTS_MAX_AGE:-}" ]] && return 0
  local subs="false" preload="false"
  [[ "${HSTS_SUBDOMAINS:-0}" -eq 1 ]] && subs="true"
  [[ "${HSTS_PRELOAD:-0}"    -eq 1 ]] && preload="true"
  cat > "${TRAEFIK_CONF_DIR}/hsts.yml" <<EOF
http:
  middlewares:
    hsts:
      headers:
        stsSeconds: ${HSTS_MAX_AGE}
        stsIncludeSubdomains: ${subs}
        stsPreload: ${preload}
        forceSTSHeader: true
EOF
}

# Mailcow SAN-Zertifikat-Route aus allen vorhandenen mail-*.yml neu aufbauen
rebuild_mailcow_san_route() {
  log "Aktualisiere Mailcow SAN-Route ..."

  # main-Domain kommt immer aus MAIL_HOSTNAME (z.B. mail.nfsmw15.de)
  # Das stellt sicher dass CERT_TARGETS und acme.json immer übereinstimmen
  local main_domain="$MAIL_HOSTNAME"
  local all_domains=()

  for conf in "${TRAEFIK_CONF_DIR}"/mail-*.yml; do
    [[ -f "$conf" ]] || continue
    while IFS= read -r d; do
      all_domains+=("$d")
    done < <(grep -oP "Host\(\`\K[^\`]+" "$conf" 2>/dev/null || true)
  done

  if [[ ${#all_domains[@]} -eq 0 ]]; then
    warn "rebuild_mailcow_san_route: keine Mail-Domains gefunden"
    return 0
  fi

  # Sicherstellen dass main_domain auch in all_domains enthalten ist
  local found=0
  for d in "${all_domains[@]}"; do
    [[ "$d" == "$main_domain" ]] && found=1
  done
  if [[ $found -eq 0 ]]; then
    warn "rebuild_mailcow_san_route: MAIL_HOSTNAME (${main_domain}) nicht in Mail-Domains gefunden"
    warn "Bitte dns-mgr add-mail <domain> fuer die MAIL_HOSTNAME-Domain aufrufen"
    # Fallback: erste mail.* Domain nehmen
    for d in "${all_domains[@]}"; do
      [[ "$d" == mail.* ]] && { main_domain="$d"; break; }
    done
    warn "Fallback main-Domain: ${main_domain}"
  fi

  # SANs = alle Domains ausser main_domain
  local sans=()
  for d in "${all_domains[@]}"; do
    [[ "$d" != "$main_domain" ]] && sans+=("$d")
  done

  write_traefik_http_san \
    "mailcow-all" "$main_domain" "${sans[@]}" \
    -- "https://${MAILCOW_IP}:443" --insecure

  info "SAN main-Domain: ${main_domain} | ${#sans[@]} SANs"
}


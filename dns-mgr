# Konfigurationsdatei — wird bevorzugt geladen
DNS_MGR_CONF="${DNS_MGR_CONF:-/etc/dns-mgr/dns-mgr.conf}"

# Interne Defaults (werden durch Config-Datei überschrieben)
PDNS_API=""
PDNS_KEY=""
TRAEFIK_CONF_DIR="/etc/traefik/conf.d"
ACME_JSON="/var/lib/traefik/acme.json"
ACME_RESOLVER="letsencrypt"
MAILCOW_IP=""
MAILCOW_KEY=""
MAILCOW_IPV6=""
MAILCOW_CERT_DIR="/opt/mailcow-dockerized/data/assets/ssl"
MAILCOW_COMPOSE_DIR="/opt/mailcow-dockerized"
HESTIA_IP=""
HESTIA_USER="admin"
HESTIA_ACCESS_KEY=""
HESTIA_SECRET_KEY=""
PUBLIC_IPV4=""
IPV6_PREFIX=""
TRAEFIK_IPV6=""
MAIL_HOSTNAME=""
SOA_HOSTMASTER=""
NS_RECORDS=()
declare -A CERT_TARGETS=()

# ── pfSense Split-DNS (optional) ──────────────────────────────────────────────
# Kein zusätzliches Paket nötig — nutzt das eingebaute XML-RPC von pfSense CE.
PFSENSE_HOST=""
PFSENSE_USER=""
PFSENSE_PASS=""

# ── HSTS (optional) ───────────────────────────────────────────────────────────
# Leer lassen = HSTS deaktiviert.
# Zum Testen mit 300 (5 Min) starten, nach Prüfung auf 31536000 (1 Jahr) erhöhen.
HSTS_MAX_AGE=""
HSTS_SUBDOMAINS=0   # 1 = includeSubDomains (nur wenn ALLE Subdomains HTTPS haben)
HSTS_PRELOAD=0      # 1 = Preload-List Eintrag (VORSICHT: quasi unwiderruflich)

STATE_DIR="/var/lib/dns-mgr"

# Config laden
if [[ -f "$DNS_MGR_CONF" ]]; then
  # shellcheck source=/etc/dns-mgr/dns-mgr.conf

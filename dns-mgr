### ═══════════════════════════════════════════════════════════════════════════
### KOMMANDO: hestia-sync
### Pollt HestiaCP-API, legt neue/entfernte Domains in PowerDNS + Traefik an
### ═══════════════════════════════════════════════════════════════════════════

cmd_hestia_sync() {
  log "HestiaCP-Domain-Sync"
  mkdir -p "$STATE_DIR"
  [[ -f "$HESTIA_STATE" ]] || echo "{}" > "$HESTIA_STATE"

  # HestiaCP REST-API: access_key + secret_key als POST-Felder
  local hestia_auth="access_key=${HESTIA_ACCESS_KEY}&secret_key=${HESTIA_SECRET_KEY}"

  # Verbindungstest + Userliste in einem einzigen Request (statt zwei
  # identischen v-list-users-Aufrufen — halbiert die Hestia-API-Last pro
  # Sync-Lauf). HTTP-Status wird per -w als letzte Zeile angehängt und
  # danach wieder vom Body getrennt.
  local hc_response hc_code hc_body
  hc_response=$(curl -sk -X POST "${HESTIA_API}" \
    --data "${hestia_auth}&cmd=v-list-users&arg1=json" \
    -w $'\n%{http_code}') || true
  hc_code="${hc_response##*$'\n'}"
  hc_body="${hc_response%$'\n'*}"

  case "$hc_code" in
    000) die "HestiaCP nicht erreichbar (${HESTIA_IP}) — LXC online?" ;;
    200) : ;;
    *)   die "HestiaCP-API HTTP ${hc_code} — Keys und IP-Whitelist prüfen (Einstellungen → Sicherheit)" ;;
  esac

  # Alle User abrufen
  local all_users
  all_users=$(echo "$hc_body" | jq -r 'keys[]' 2>/dev/null) \
    || die "HestiaCP-API: ungültige Antwort"

  # Aktuelle Domains als JSON: { "user": ["domain1", "domain2"], ... }
  local current_json="{}"
  while IFS= read -r huser; do
    [[ -z "$huser" ]] && continue
    local user_domains
    user_domains=$(curl -sk -X POST "${HESTIA_API}" \
      --data "${hestia_auth}&cmd=v-list-web-domains&arg1=${huser}&arg2=json" \
      | jq -r 'keys[]' 2>/dev/null | jq -R . | jq -s .) || continue
    current_json=$(echo "$current_json" \
      | jq --arg u "$huser" --argjson d "$user_domains" '.[$u] = $d')
  done <<< "$all_users"

  local known_json
  known_json=$(cat "$HESTIA_STATE")

  # Neue Domains = in current aber nicht in known
  local new_domains
  new_domains=$(jq -rn     --argjson cur "$current_json"     --argjson known "$known_json"     '($cur | to_entries[]) as $e |
     ($known[$e.key] // []) as $k |
     ($e.value - $k)[] |
     . + " " + $e.key')   # "domain user"

  # Entfernte Domains = in known aber nicht in current
  local removed_domains
  removed_domains=$(jq -rn     --argjson cur "$current_json"     --argjson known "$known_json"     '($known | to_entries[]) as $e |
     ($cur[$e.key] // []) as $c |
     ($e.value - $c)[] |
     . + " " + $e.key')   # "domain user"

  local changed=0

  # Neue Domains anlegen
  if [[ -n "$new_domains" ]]; then
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      local domain huser
      domain="${line%% *}"
      huser="${line##* }"
      log "Neue HestiaCP-Domain: ${domain} (User: ${huser})"
      cmd_add_web "$domain"
      changed=1
    done <<< "$new_domains"
  fi

  # Entfernte Domains aufräumen
  if [[ -n "$removed_domains" ]]; then
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      local domain huser
      domain="${line%% *}"
      huser="${line##* }"
      log "Domain aus HestiaCP entfernt: ${domain} (User: ${huser})"
      # Nur Traefik-Config entfernen, Zone bleibt (könnte noch Mail haben)
      remove_traefik_config "$(safe_name "$domain")"
      log "Traefik-Config fuer ${domain} entfernt (Zone bleibt erhalten)"
      changed=1
    done <<< "$removed_domains"
  fi

  if [[ $changed -eq 0 ]]; then
    log "Keine Aenderungen in HestiaCP"
  fi

  # State aktualisieren
  echo "$current_json" > "$HESTIA_STATE"
  log "HestiaCP-Sync abgeschlossen"
}


### ═══════════════════════════════════════════════════════════════════════════
### KOMMANDO: init-config
### Erstellt eine kommentierte Beispiel-Konfigurationsdatei
### ═══════════════════════════════════════════════════════════════════════════

cmd_init_config() {
  local target="${1:-/etc/dns-mgr/dns-mgr.conf}"
  if [[ -f "$target" ]]; then
    read -r -p "${target} existiert bereits. Ueberschreiben? [j/N] " confirm
    [[ "$confirm" != "j" && "$confirm" != "J" ]] && { log "Abgebrochen"; exit 0; }
  fi
  mkdir -p "$(dirname "$target")"
  chmod 700 "$(dirname "$target")"

  cat > "$target" << 'CONF'
# =============================================================================
# dns-mgr Konfiguration
# Ort:    /etc/dns-mgr/dns-mgr.conf
# Rechte: chmod 600 (enthaelt API-Keys)
# =============================================================================

# ── PowerDNS (LXC 119) ───────────────────────────────────────────────────────
PDNS_API="http://192.168.1.119:8081/api/v1"
PDNS_KEY="DEIN-POWERDNS-API-KEY"

# ── Traefik (lokal auf LXC 120) ──────────────────────────────────────────────
TRAEFIK_CONF_DIR="/etc/traefik/conf.d"
ACME_JSON="/var/lib/traefik/acme.json"
ACME_RESOLVER="letsencrypt"

# ── Mailcow (LXC 106) ────────────────────────────────────────────────────────
MAILCOW_IP="192.168.1.106"
MAILCOW_KEY="DEIN-MAILCOW-API-KEY"
MAILCOW_IPV6="2a01:4f8:10b:f101::106"
MAILCOW_CERT_DIR="/opt/mailcow-dockerized/data/assets/ssl"
MAILCOW_COMPOSE_DIR="/opt/mailcow-dockerized"

# ── HestiaCP (LXC 118) ───────────────────────────────────────────────────────
# Access Key erstellen: v-add-access-key admin dns-mgr dns-mgr json
HESTIA_IP="192.168.1.118"
HESTIA_USER="admin"
HESTIA_ACCESS_KEY="DEIN-ACCESS-KEY"
HESTIA_SECRET_KEY="DEIN-SECRET-KEY"

# ── Oeffentliche Adressen ─────────────────────────────────────────────────────
PUBLIC_IPV4="DEINE-HETZNER-IPv4"
IPV6_PREFIX="2a01:4f8:10b:f101"   # /64-Prefix OHNE :: am Ende

# ── DNS / Nameserver ─────────────────────────────────────────────────────────
MAIL_HOSTNAME="mail.DEINE-HAUPTDOMAIN.tld"
SOA_HOSTMASTER="hostmaster.DEINE-HAUPTDOMAIN.tld."
NS_RECORDS=(
  "ns1.DEINE-HAUPTDOMAIN.tld."
  "ns2.DEINE-HAUPTDOMAIN.tld."   # VPS Fremd-Hoster Secondary NS
  "helium.ns.hetzner.de."
  "oxygen.ns.hetzner.com."
  "hydrogen.ns.hetzner.com."
)

# ── Zertifikat-Deployment-Targets ────────────────────────────────────────────
# Jeder Eintrag: [name]="host:cert-pfad:key-pfad:reload-cmd:main-domain"
#
#   name        Frei waehlbarer Name (fuer --target <name>)
#   host        SSH-Ziel IP. Leer lassen fuer lokales Deployment.
#   cert-pfad   Vollstaendiger Pfad zur cert.pem auf dem Zielhost
#   key-pfad    Vollstaendiger Pfad zur key.pem auf dem Zielhost
#   reload-cmd  Shell-Kommando nach Update auf dem Zielhost. Leer = keines.
#   main-domain Muss mit domain.main in acme.json uebereinstimmen
#               (= erste Domain in der Traefik-Route)
#
# Mailcow: SAN-Cert fuer alle mail.* Subdomains aller Mail-Domains.
# main-domain = erste mail.* Domain die mit add-mail angelegt wurde.
declare -A CERT_TARGETS
CERT_TARGETS=(
  [mailcow]="192.168.1.106:/opt/mailcow-dockerized/data/assets/ssl/cert.pem:/opt/mailcow-dockerized/data/assets/ssl/key.pem:cd /opt/mailcow-dockerized && docker compose restart nginx-mailcow postfix-mailcow dovecot-mailcow:mail.DEINE-HAUPTDOMAIN.tld"

  # Mumble-Beispiel:
  # [mumble]="192.168.1.132:/etc/mumble-server/cert.pem:/etc/mumble-server/key.pem:systemctl restart mumble-server:mumble.DEINE-DOMAIN.tld"

  # Lokales Deployment (z.B. SSHFS-Mount, kein SSH):
  # [lokal]=":/lokaler/pfad/cert.pem:/lokaler/pfad/key.pem::app.DEINE-DOMAIN.tld"
)

# ── pfSense Split-DNS (optional) ─────────────────────────────────────────────
# Ermoeglicht automatisches Setzen von Unbound Host Overrides in pfSense,
# damit interne Clients Domains direkt zur LAN-IP aufloesen (kein NAT-Loopback).
#
# Kein Paket noetig — nutzt das eingebaute XML-RPC von pfSense CE.
# Zugangsdaten: normaler pfSense Admin-User und Passwort.
#
# Wenn PFSENSE_HOST leer bleibt, wird Split-DNS einfach uebersprungen.
PFSENSE_HOST=""           # z.B. 192.168.1.1
PFSENSE_USER=""           # pfSense Admin-Benutzername (z.B. admin)
PFSENSE_PASS=""           # pfSense Admin-Passwort

# ── HSTS (optional) ───────────────────────────────────────────────────────────
# Leer lassen = HSTS deaktiviert.
# Ablauf: erst 300 (5 Min) setzen + dns-mgr enable-hsts ausfuehren + testen,
# dann auf 31536000 (1 Jahr) erhoehen + erneut enable-hsts.
HSTS_MAX_AGE=""           # Sekunden (300 = Test, 31536000 = Produktion)
HSTS_SUBDOMAINS=0         # 1 = includeSubDomains
HSTS_PRELOAD=0            # 1 = Preload (VORSICHT: quasi unwiderruflich)

# ── State-Verzeichnis ─────────────────────────────────────────────────────────
# Hier speichert dns-mgr bekannte Domains (fuer hestia-sync, mailcow-sync)
# und MTA-STS IDs. Normalerweise nicht aendern.
STATE_DIR="/var/lib/dns-mgr"
CONF

  chmod 600 "$target"
  log "Konfigurationsdatei erstellt: ${target}"
  log "Bitte alle DEIN-* Platzhalter anpassen, dann:"
  log "  chmod 600 ${target}"
}

### ═══════════════════════════════════════════════════════════════════════════
### KOMMANDO: enable-hsts / disable-hsts
### ═══════════════════════════════════════════════════════════════════════════

cmd_enable_hsts() {
  [[ -z "${HSTS_MAX_AGE:-}" ]] && \
    die "HSTS_MAX_AGE nicht gesetzt — in dns-mgr.conf setzen (z.B. HSTS_MAX_AGE=300)"

  write_hsts_middleware
  log "HSTS-Middleware geschrieben: ${TRAEFIK_CONF_DIR}/hsts.yml (max-age=${HSTS_MAX_AGE})"

  local patched=0 skipped=0
  for yml in "${TRAEFIK_CONF_DIR}"/*.yml; do
    [[ -f "$yml" ]] || continue
    [[ "$(basename "$yml")" == "hsts.yml" ]] && continue
    if grep -q '\bhsts\b' "$yml"; then
      (( skipped++ )) || true
      continue
    fi
    local changed=0
    # Format 1: middlewares: [xxx]
    if grep -q 'middlewares: \[' "$yml"; then
      sed -i 's/middlewares: \[/middlewares: [hsts, /' "$yml"
      changed=1
    fi
    # Format 2: middlewares:\n  - xxx
    if grep -qP '^\s+middlewares:\s*$' "$yml"; then
      perl -i -0pe 's/([ \t]+middlewares:\n)([ \t]+- )(?!hsts)/$1$2hsts\n$2/g' "$yml"
      changed=1
    fi
    [[ $changed -eq 1 ]] && (( patched++ )) || true
  done

  log "HSTS aktiviert — ${patched} Configs aktualisiert, ${skipped} bereits vorhanden"
  log "Browser cached HSTS für ${HSTS_MAX_AGE} Sekunden ab erstem HTTPS-Aufruf"
  if [[ "${HSTS_MAX_AGE}" -ge 86400 ]] 2>/dev/null; then
    warn "max-age >= 1 Tag — teste vorher mit einem Browser ob alles erreichbar ist"
  fi
}

cmd_disable_hsts() {
  local removed=0

  [[ -f "${TRAEFIK_CONF_DIR}/hsts.yml" ]] && \
    rm -f "${TRAEFIK_CONF_DIR}/hsts.yml" && log "hsts.yml gelöscht"

  for yml in "${TRAEFIK_CONF_DIR}"/*.yml; do
    [[ -f "$yml" ]] || continue
    if grep -q '\bhsts\b' "$yml"; then
      # Format 1: [hsts, xxx] oder [xxx, hsts]
      sed -i 's/middlewares: \[hsts, /middlewares: [/' "$yml"
      sed -i 's/, hsts\]/]/' "$yml"
      # Format 2: - hsts Zeile entfernen
      sed -i '/^[[:space:]]*- hsts[[:space:]]*$/d' "$yml"
      (( removed++ )) || true
    fi
  done

  log "HSTS deaktiviert — ${removed} Configs bereinigt"
  [[ -n "${HSTS_MAX_AGE:-}" ]] && \
    warn "Browser behalten HSTS noch bis zu ${HSTS_MAX_AGE}s (Cache läuft ab)"
}

### ═══════════════════════════════════════════════════════════════════════════
### KOMMANDO: sync-split-dns
### Liest alle Traefik-Configs und gleicht Unbound Host Overrides in pfSense ab
### ═══════════════════════════════════════════════════════════════════════════

cmd_sync_split_dns() {
  pfsense_configured \
    || die "Split-DNS nicht konfiguriert — PFSENSE_HOST, PFSENSE_USER, PFSENSE_PASS in dns-mgr.conf setzen"

  log "Split-DNS Sync: lese Traefik-Configs aus ${TRAEFIK_CONF_DIR}"

  # Gewünschte Overrides aus Traefik-Configs: "host_part|domain_part" → "ip"
  local -A desired=()

  for yml in "${TRAEFIK_CONF_DIR}"/*.yml; do
    [[ -f "$yml" ]] || continue
    local backend_ip
    backend_ip=$(grep -oP 'url: "?\K[^"]+' "$yml" 2>/dev/null \
      | head -1 | grep -oP '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    [[ -z "$backend_ip" ]] && continue
    while IFS= read -r fqdn; do
      [[ -z "$fqdn" ]] && continue
      local zone; zone=$(get_zone_for_domain "$fqdn")
      if [[ -z "$zone" ]]; then
        local -a fparts; IFS='.' read -ra fparts <<< "$fqdn"
        local fn=${#fparts[@]}
        [[ $fn -ge 2 ]] && zone="${fparts[$((fn-2))]}.${fparts[$((fn-1))]}" || zone="$fqdn"
      fi
      local h d
      [[ "$fqdn" == "$zone" ]] && h="" || h="${fqdn%.${zone}}"
      d="$zone"
      desired["${h}|${d}"]="$backend_ip"
    done < <(grep -oP "Host\(\`\K[^\`]+" "$yml" 2>/dev/null || true)
  done

  log "Domains in Traefik-Configs: ${#desired[@]}"

  # Bestehende pfSense Overrides einmalig laden
  local list_php="\$out=array();
if(is_array(\$config['unbound']['hosts'])){
  foreach(\$config['unbound']['hosts'] as \$k=>\$h){
    \$out[]=array('id'=>\$k,'host'=>isset(\$h['host'])?\$h['host']:'','domain'=>isset(\$h['domain'])?\$h['domain']:'','ip'=>isset(\$h['ip'])?\$h['ip']:'','descr'=>isset(\$h['descr'])?\$h['descr']:'');
  }
}
echo json_encode(\$out);"

  local existing_json
  existing_json=$(pfsense_exec_php "$list_php") \
    || die "pfSense nicht erreichbar — Zugangsdaten prüfen"
  [[ -z "$existing_json" || "$existing_json" == "null" ]] && \
    die "pfSense XML-RPC: keine Antwort — PFSENSE_USER/PFSENSE_PASS prüfen"

  local updated=0 unchanged=0 removed=0

  # Gewünschte Overrides setzen / aktualisieren
  for key in "${!desired[@]}"; do
    local h="${key%%|*}" d="${key##*|}" ip="${desired[$key]}"
    local existing_ip
    existing_ip=$(echo "$existing_json" \
      | jq -r --arg h "$h" --arg d "$d" \
        '.[] | select(.host == $h and .domain == $d) | .ip' 2>/dev/null | head -1)

    if [[ "$existing_ip" == "$ip" ]]; then
      info "Unverändert: ${h:+$h.}${d} → ${ip}"
      (( unchanged++ )) || true
      continue
    fi

    local set_php="require_once('unbound.inc');
\$h='${h}'; \$d='${d}'; \$ip='${ip}'; \$desc='dns-mgr: ${h:+$h.}${d}';
if(!is_array(\$config['unbound']['hosts'])){\$config['unbound']['hosts']=array();}
\$found=false;
foreach(\$config['unbound']['hosts'] as \$k=>\$hh){
  if(\$hh['host']===\$h&&\$hh['domain']===\$d){\$config['unbound']['hosts'][\$k]['ip']=\$ip;\$found=true;break;}
}
if(!\$found){\$config['unbound']['hosts'][]=array('host'=>\$h,'domain'=>\$d,'ip'=>\$ip,'descr'=>\$desc,'aliases'=>array());}
write_config('dns-mgr');
echo 'ok';"

    local result
    if result=$(pfsense_exec_php "$set_php" 2>/dev/null) && [[ "$result" == "ok" ]]; then
      log "Gesetzt: ${h:+$h.}${d} → ${ip}"
      (( updated++ )) || true
    else
      warn "Fehlgeschlagen: ${h:+$h.}${d}"
    fi
  done

  # Von dns-mgr angelegte, nun veraltete Overrides entfernen
  while IFS=$'\t' read -r oh od; do
    [[ -z "$oh" && -z "$od" ]] && continue
    local key="${oh}|${od}"
    if [[ -z "${desired[$key]+x}" ]]; then
      local del_php="require_once('unbound.inc');
\$h='${oh}'; \$d='${od}';
\$deleted=false;
if(is_array(\$config['unbound']['hosts'])){
  foreach(\$config['unbound']['hosts'] as \$k=>\$hh){
    if(\$hh['host']===\$h&&\$hh['domain']===\$d){unset(\$config['unbound']['hosts'][\$k]);\$deleted=true;}
  }
  \$config['unbound']['hosts']=array_values(\$config['unbound']['hosts']);
}
if(\$deleted){write_config('dns-mgr');}
echo \$deleted?'deleted':'notfound';"
      local result
      if result=$(pfsense_exec_php "$del_php" 2>/dev/null) && [[ "$result" == "deleted" ]]; then
        log "Veraltet entfernt: ${oh:+$oh.}${od}"
        (( removed++ )) || true
      fi
    fi
  done < <(echo "$existing_json" \
    | jq -r '.[] | select(.descr | startswith("dns-mgr:")) | [.host, .domain] | @tsv' \
    2>/dev/null || true)

  # Einmaliger Unbound-Reload nach allen Änderungen
  if [[ $((updated + removed)) -gt 0 ]]; then
    local reload_php="require_once('unbound.inc'); services_unbound_configure(false); echo 'ok';"
    pfsense_exec_php "$reload_php" >/dev/null 2>&1 \
      || warn "Unbound Reload fehlgeschlagen (nicht kritisch)"
  fi

  log "Split-DNS Sync abgeschlossen — ${updated} aktualisiert, ${unchanged} unverändert, ${removed} entfernt"
}

### ═══════════════════════════════════════════════════════════════════════════
### KOMMANDO: list-split-dns
### Zeigt alle Unbound Host Overrides in pfSense
### ═══════════════════════════════════════════════════════════════════════════

cmd_list_split_dns() {
  pfsense_configured \
    || die "Split-DNS nicht konfiguriert — PFSENSE_HOST, PFSENSE_USER, PFSENSE_PASS in dns-mgr.conf setzen"

  local list_php="\$out=array();
if(is_array(\$config['unbound']['hosts'])){
  foreach(\$config['unbound']['hosts'] as \$k=>\$h){
    \$out[]=array('host'=>isset(\$h['host'])?\$h['host']:'','domain'=>isset(\$h['domain'])?\$h['domain']:'','ip'=>isset(\$h['ip'])?\$h['ip']:'','descr'=>isset(\$h['descr'])?\$h['descr']:'');
  }
}
echo json_encode(\$out);"

  local json
  json=$(pfsense_exec_php "$list_php") || die "pfSense nicht erreichbar"
  [[ -z "$json" || "$json" == "null" ]] && die "pfSense XML-RPC: keine Antwort — Zugangsdaten prüfen"

  local count
  count=$(echo "$json" | jq 'length' 2>/dev/null || echo "0")

  echo ""
  echo "pfSense Unbound Host Overrides (${count} gesamt):"
  printf "  %-40s  %-15s  %s\n" "DOMAIN" "IP" "BESCHREIBUNG"
  printf "  %-40s  %-15s  %s\n" "------" "--" "------------"
  echo "$json" | jq -r '.[] | "\(.host)|\(.domain)|\(.ip)|\(.descr)"' 2>/dev/null \
    | while IFS='|' read -r h d ip descr; do
        printf "  %-40s  %-15s  %s\n" "${h:+$h.}${d}" "$ip" "$descr"
      done
}

